<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Version>0.9.0</Version>
    <AssemblyName>StellarPerformance</AssemblyName>
    <Authors>SilentHacks</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The minimal release omits PDBs; reproduce its DLL from source archives without .git. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/StellarPerformance</PathMap>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Import Project="../../GameReferences.props" />
  <ItemGroup>
    <EmbeddedResource Include="../../LICENSE" LogicalName="StellarPerformance.LICENSE" />
    <EmbeddedResource Include="../../CREDITS.md" LogicalName="StellarPerformance.CREDITS" />
    <None Include="../../mod.json" Link="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
