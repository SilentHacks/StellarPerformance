<Project>
  <ItemGroup>
    <_GameAssembly Include="Assembly-CSharp;CablesMesh;Core;FishNet.Runtime;Items.Model;MKEdgeDetection;MKEdgeDetectionUniversalRendererFeature;Newtonsoft.Json;Planets;Players;Rendering;Players.Interface;Saving;Saving.Serialization;Ships;Ships.Interface;Tools;Tools.Interface;UI;UI.Interface;Unity.InputSystem;Unity.TextMeshPro;Unity.RenderPipelines.Core.Runtime;Unity.RenderPipelines.Universal.Runtime;UnityEngine.TextRenderingModule;UnityEngine.IMGUIModule;UnityEngine.ParticleSystemModule;UnityEngine.AnimationModule;UnityEngine.CoreModule;UnityEngine.PhysicsModule;UnityEngine.UI;UnityEngine.UIModule;WorldObjects;WorldObjects.Interface;WorldProvision.Interface;WorldTracking;WorldTracking.Interface;com.rlabrecque.steamworks.net" />
    <Reference Include="@(_GameAssembly)">
      <HintPath>$(GameManagedDirectory)/%(Identity).dll</HintPath>
      <Private>false</Private>
      <Private Condition="'$(IsTestProject)' == 'true'">true</Private>
    </Reference>
    <Reference Include="MelonLoader;0Harmony">
      <HintPath>$(GameDirectory)/MelonLoader/net472/%(Identity).dll</HintPath>
      <Private>false</Private>
      <Private Condition="'$(IsTestProject)' == 'true'">true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckLocalGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" Text="Missing local reference %(Reference.HintPath). Set GameDirectory to an installed StellarDrive Demo with MelonLoader; see README.md." />
  </Target>
</Project>
