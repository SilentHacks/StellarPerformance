<Project>
  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(STELLARDRIVE_GAME_DIRECTORY)</GameDirectory>
    <GameDirectory Condition="'$(GameDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo</GameDirectory>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />
  <PropertyGroup>
    <GameManagedDirectory>$(GameDirectory)/StellarDrive_Data/Managed</GameManagedDirectory>
  </PropertyGroup>
</Project>
